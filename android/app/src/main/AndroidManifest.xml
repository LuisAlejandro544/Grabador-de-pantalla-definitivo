<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml para VeloRec Studio
    Configurado para cumplimiento estricto con Android 14+ (API 34/35):
    - Permiso FOREGROUND_SERVICE_MEDIA_PROJECTION para grabación de pantalla.
    - Permiso RECORD_AUDIO para captura de micrófono o audio interno.
    - Declaración del servicio en primer plano ScreenRecordService.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permisos de captura de pantalla y servicios en primer plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    
    <!-- Permisos de audio, notificaciones y conexión a internet para actualizaciones remotas -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Cumplimiento con Android 14+ (API 34+) para acceso parcial a fotos y videos seleccionados -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Permiso y consultas para listar juegos y apps instaladas en el Lanzador Rápido con Grabación Automática -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Aceleración por hardware obligatoria y compatibilidad de almacenamiento -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <!-- Declaración del servicio en primer plano para MediaProjection y Micrófono en Android 14+ (API 34/35) -->
        <!-- Ejecutado en el proceso principal para cumplir con la política estricta de seguridad de Android 14+,
             donde el token de MediaProjection otorgado por la Activity solo es válido dentro del mismo UID/PID y
             para garantizar reactividad directa de StateFlow sin serialización IPC propensa a fallos -->
        <service
            android:name=".ScreenRecordService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad autónoma de diagnóstico e inspección de Logcat y Crashes (Estilo LeakCanary) -->
        <!-- Se deshabilita y elimina completamente del APK en compilaciones Release ('enableDebugInspector = false') -->
        <!-- Solo se habilita en compilaciones Debug para inspección interna sin root -->
        <activity
            android:name=".debug.DebugConsoleActivity"
            android:label="VeloRec Inspector"
            android:exported="true"
            android:enabled="${enableDebugInspector}"
            android:taskAffinity="com.velorec.recorder.debug"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider para compartir y reproducir videos MP4 grabados sin FileUriExposedException -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
    </application>

</manifest>
